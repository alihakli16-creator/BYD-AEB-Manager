<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_touch_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/afs_bubble_min_touch_size"
    android:minHeight="@dimen/afs_bubble_min_touch_size">

    <LinearLayout
        android:id="@+id/floating_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hud_glass_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/afs_bubble_padding_h"
        android:paddingVertical="@dimen/afs_bubble_padding_v">

        <TextView
            android:id="@+id/floating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="0"
            android:text="..."
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/afs_bubble_text_size"
            android:textStyle="normal" />

    </LinearLayout>

</FrameLayout>
